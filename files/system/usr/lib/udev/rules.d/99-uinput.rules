# ydotool needs write access to /dev/uinput. illogical-impulse uses ydotool
# for the virtual keyboard and various keybinds.
#
# uaccess instead of a fixed group: with it systemd-logind sets an ACL for the
# currently logged-in session user. That works without `usermod -aG`, which on
# an atomic system would otherwise be a manual follow-up step. The group
# permissions stay in addition, as a fallback.
SUBSYSTEM=="misc", KERNEL=="uinput", TAG+="uaccess", OPTIONS+="static_node=uinput", MODE="0660", GROUP="input"
