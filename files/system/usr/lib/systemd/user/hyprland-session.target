[Unit]
Description=Hyprland session
Documentation=man:systemd.special(7)

# Why this unit exists at all:
#
# Hyprland is started directly by the login manager here, not through uwsm -
# the upstream illogical-impulse installer even explicitly warns against
# picking the UWSM entry in the login manager. But that means nobody activates
# graphical-session.target, and it cannot be started by hand either
# ("Operation refused, unit may be requested by dependency only").
#
# Consequence without this unit: every xdg-desktop-portal backend stays dead,
# because they all require graphical-session.target. Electron applications such
# as Discord and Chrome then hang on startup or freeze - which is exactly what
# happened on the target machine.
#
# BindsTo pulls graphical-session.target up along with it. This unit is started
# from ~/.config/hypr/custom/execs.lua once the compositor is up.
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target

# Autostart of ~/.config/autostart/*.desktop.
#
# systemd always runs systemd-xdg-autostart-generator, which turns every XDG
# autostart desktop file into a unit app-<name>@autostart.service. What is
# missing without a desktop environment is the trigger:
# xdg-desktop-autostart.target carries RefuseManualStart=yes and only comes up
# when a session unit wants it. Plasma does that in plasma-workspace.target;
# Hyprland ships nothing of the sort, so under this session the entries made in
# KDE (EasyEffects, Steam, Netbird, ...) were simply never started.
#
# Entries under /etc/xdg/autostart with OnlyShowIn=KDE or GNOME stay dead on
# purpose: the generator gives each unit an ExecCondition that compares against
# XDG_CURRENT_DESKTOP, and that is "Hyprland" here.
Wants=xdg-desktop-autostart.target
Before=xdg-desktop-autostart.target
