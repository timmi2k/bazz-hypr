[Unit]
Description=Set up illogical-impulse and end4-pC in the user's home
Documentation=https://github.com/end-4/dots-hyprland
# Must be finished before a graphical session reads any configuration.
Before=graphical-session-pre.target
ConditionPathExists=/usr/share/bazz-hypr/dots-hyprland

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/bazz-hypr-seed
# A failure here must not block the login; the message lands in the journal
# (journalctl --user -u bazz-hypr-firstrun).
SuccessExitStatus=0 1
TimeoutStartSec=300

[Install]
WantedBy=default.target
