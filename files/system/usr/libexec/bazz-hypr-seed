#!/usr/bin/env bash
# Legt illogical-impulse + end4-pC im HOME des aufrufenden Benutzers an.
#
# Warum ueberhaupt noetig: /etc/skel greift nur bei NEU angelegten Benutzern.
# Dieses Image landet per `rpm-ostree rebase` auf einer Maschine, auf der der
# Account laengst existiert - dort wuerde skel nie ausgewertet.
#
# Idempotent: laeuft bei jedem Login, macht aber nur etwas, wenn sich die
# Image-Version geaendert hat oder Dateien fehlen.
set -euo pipefail

SHARE="/usr/share/bazz-hypr"
DOTS="$SHARE/dots-hyprland/dots"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}"
STAMP="$STATE/bazz-hypr/seeded"
LOCK="$STATE/bazz-hypr/seed.lock"

log() { printf '[bazz-hypr-seed] %s\n' "$*"; }

test -d "$DOTS" || { log "FEHLER: $DOTS fehlt - kaputtes Image?"; exit 1; }

mkdir -p "$CONF" "$DATA" "$STATE/bazz-hypr"

# --- 0. Sperre ---------------------------------------------------------------
# Dieses Skript hat zwei Ausloeser: den Session-Wrapper und den User-Dienst
# bazz-hypr-firstrun.service. Beide starten beim Login praktisch gleichzeitig.
#
# Ohne Sperre loeschte der zweite Lauf mit `rm -rf "$VENV.tmp"` das
# Staging-Verzeichnis des ersten mitten im Kopieren; der erste brach daraufhin
# per `set -e` ab, bevor er die Konfiguration schreiben konnte, und Hyprland
# startete ohne hyprland.lua. Genau so ist der erste echte Login schiefgegangen.
exec 9>"$LOCK"
if ! flock -w 300 9; then
    log "FEHLER: konnte Sperre $LOCK nicht bekommen"
    exit 1
fi

VERSION="$(cat "$SHARE/dots-version" 2>/dev/null || echo unknown)"
STAMPED="$(cat "$STAMP" 2>/dev/null || true)"

# --- 1. Upstream-eigene Konfiguration ----------------------------------------
# BEWUSST VOR dem venv: Hyprland startet direkt nach diesem Skript und braucht
# hyprland.lua sofort. Das venv-Kopieren dauert deutlich laenger und ist fuer
# den Start der Session nicht kritisch.
#
# Diese Pfade gehoeren illogical-impulse und werden bei jedem Image-Update
# ueberschrieben - genauso macht es der Upstream-Installer.
if [ "$VERSION" != "$STAMPED" ]; then
    log "synchronisiere Upstream-Konfiguration (Version $VERSION)"
    mkdir -p "$CONF/quickshell" "$CONF/hypr"
    rsync -a --delete "$DOTS/.config/quickshell/ii/" "$CONF/quickshell/ii/"
    rsync -a --delete "$DOTS/.config/hypr/hyprland/" "$CONF/hypr/hyprland/"
    rsync -a           "$DOTS/.config/matugen/"       "$CONF/matugen/"
    mkdir -p "$DATA/icons"
    cp -f "$DOTS/.local/share/icons/illogical-impulse.svg" "$DATA/icons/" 2>/dev/null || true
fi

# hyprland.lua gehoert ebenfalls dem Upstream und wird immer erneuert.
#
# Wichtig: Wenn Hyprland startet und die Datei fehlt, schreibt es sich selbst
# eine Default-Konfiguration an genau diese Stelle ("No config file found;
# attempting to generate"). Wuerde hier nur bei fehlender Datei kopiert, bliebe
# diese generierte Default-Config dauerhaft stehen - der Desktop kaeme bei
# jedem Login ohne Keybinds, ohne Shell-Autostart und ohne Einstellungen hoch.
if ! cmp -s "$DOTS/.config/hypr/hyprland.lua" "$CONF/hypr/hyprland.lua"; then
    if [ -f "$CONF/hypr/hyprland.lua" ]; then
        cp -f "$CONF/hypr/hyprland.lua" "$CONF/hypr/hyprland.lua.bak"
        log "hyprland.lua weicht ab - alte Fassung als hyprland.lua.bak gesichert"
    fi
    install -m 0644 "$DOTS/.config/hypr/hyprland.lua" "$CONF/hypr/hyprland.lua"
    log "hyprland.lua aus dem Image gesetzt"
fi

# --- 2. Benutzer-eigene Konfiguration ----------------------------------------
# Wird nur angelegt, wenn nicht vorhanden. Nach einem Rebase hat der Benutzer
# ein eingerichtetes KDE - dessen kitty/fish/kdeglobals nicht ueberbuegeln.
seed_if_missing() {
    local src="$1" dst="$2"
    [ -e "$dst" ] && return 0
    mkdir -p "$(dirname "$dst")"
    cp -a "$src" "$dst"
    chmod -R u+w "$dst"
    log "angelegt: ${dst#"$HOME"/}"
}

for entry in "$DOTS"/.config/*; do
    name="$(basename "$entry")"
    case "$name" in
        quickshell|hypr|matugen) continue ;;   # oben behandelt
    esac
    seed_if_missing "$entry" "$CONF/$name"
done

for f in hyprlock.conf hypridle.conf; do
    seed_if_missing "$DOTS/.config/hypr/$f" "$CONF/hypr/$f"
done
seed_if_missing "$DOTS/.config/hypr/hyprlock" "$CONF/hypr/hyprlock"
seed_if_missing "$DOTS/.config/hypr/custom"   "$CONF/hypr/custom"
seed_if_missing "$DOTS/.local/share/konsole"  "$DATA/konsole"

# --- 3. end4-pC --------------------------------------------------------------
# Reiner Quickshell-Config-Ordner (GPL-3.0), setzt illogical-impulse voraus.
# Als echter git-Checkout kopiert, damit `git pull` darin funktioniert.
if [ ! -d "$CONF/quickshell/end4-pC" ] && [ -d "$SHARE/end4-pC" ]; then
    log "installiere end4-pC nach $CONF/quickshell/end4-pC"
    mkdir -p "$CONF/quickshell"
    cp -a "$SHARE/end4-pC" "$CONF/quickshell/end4-pC"
    chmod -R u+w "$CONF/quickshell/end4-pC"
fi

# --- 4. Unsere Anpassungen in hypr/custom/ -----------------------------------
# custom/ wird von illogical-impulse-Updates nie angefasst - der richtige Ort
# fuer Nvidia-Variablen, Tastaturlayout und die Shell-Auswahl.
#
# ACHTUNG bei der Leer-Pruefung: Die Vorlagen des Upstream sind nicht 0 Byte
# gross, sondern enthalten ein einzelnes Newline. Ein Test auf `[ -s ]` haelt
# sie faelschlich fuer befuellt und ueberspringt das Schreiben - genau daran
# ist der erste Anlauf gescheitert. Deshalb wird auf "nur Leerraum" geprueft.
is_effectively_empty() {
    [ ! -e "$1" ] && return 0
    [ -z "$(tr -d '[:space:]' < "$1" 2>/dev/null)" ]
}

write_once() {
    local path="$1"
    if ! is_effectively_empty "$path"; then
        cat > /dev/null   # Heredoc leerlesen
        return 0
    fi
    mkdir -p "$(dirname "$path")"
    cat > "$path"
    log "geschrieben: ${path#"$HOME"/}"
}

# Haengt einen markierten Block an, statt die ganze Datei zu schreiben.
#
# Warum zusaetzlich zu write_once: write_once ruehrt eine Datei nur an, solange
# sie leer ist. custom/keybinds.lua bringt der Upstream aber bereits mit einer
# Zeile mit ("Edit user keybinds"), womit write_once sie immer uebersprungen
# haette - der Block waere auf einer frischen Installation nie gelandet.
#
# Die Marke bleibt als Kommentar stehen und ist die einzige Erkennung: ein
# zweiter Lauf findet sie und haengt nichts nach. Wer den Block nicht will,
# loescht ihn samt Marke -- dann kommt er beim naechsten Login wieder; wer ihn
# anpassen will, laesst die Marke stehen und aendert darunter frei herum.
append_once() {
    local path="$1" marker="$2"
    # -e ist Pflicht, nicht Kosmetik: die Marke beginnt mit "--", ohne -e haelt
    # grep sie fuer eine Optionsliste, bricht ab und meldet "nicht gefunden" -
    # der Block waere dann bei jedem Login erneut angehaengt worden.
    if [ -e "$path" ] && grep -qFe "$marker" "$path" 2>/dev/null; then
        cat > /dev/null   # Heredoc leerlesen
        return 0
    fi
    mkdir -p "$(dirname "$path")"
    printf '\n%s\n' "$marker" >> "$path"
    cat >> "$path"
    log "ergaenzt: ${path#"$HOME"/}"
}

write_once "$CONF/hypr/custom/env.lua" <<'LUA'
-- Nvidia. Stand wiki.hypr.land/Nvidia/ (Abruf 2026-09-08).
-- Nur noch diese beiden Variablen werden empfohlen. GBM_BACKEND=nvidia-drm
-- steht dort NICHT mehr - es hat mehr Probleme verursacht (u.a. in Firefox)
-- als geloest, deshalb hier bewusst weggelassen.
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")

-- Hardware-Videodecoding ueber NVDEC statt ueber den VDPAU-Umweg.
hl.env("NVD_BACKEND", "direct")

-- Bei mehreren GPUs hier die gewuenschte Karte festnageln, z.B.:
-- hl.env("AQ_DRM_DEVICES", "/dev/dri/card1:/dev/dri/card0")
LUA

write_once "$CONF/hypr/custom/variables.lua" <<'LUA'
-- Welcher Ordner unter ~/.config/quickshell/ die Shell stellt.
-- "ii"       = illogical-impulse im Original
-- "end4-pC"  = der Fork von pctrade (in diesem Image mitgeliefert)
hl.env("qsConfig", "end4-pC")
LUA

write_once "$CONF/hypr/custom/execs.lua" <<'LUA'
-- Auf Fedora startet der polkit-Agent nicht von allein. Ohne ihn erscheint bei
-- jeder Rechteabfrage gar kein Dialog.
--
-- Der Upstream-Installer haengt die Zeile dafuer an hypr/hyprland/execs.conf
-- an - eine Datei, die seit der Lua-Umstellung nicht mehr gelesen wird.
-- gnome-keyring-daemon wird hier bewusst NICHT gestartet, das macht
-- hyprland/execs.lua bereits selbst.
hl.on("hyprland.start", function()
    hl.exec_cmd("/usr/libexec/kf6/polkit-kde-authentication-agent-1")

    -- graphical-session.target hochziehen. Hyprland wird direkt vom
    -- Login-Manager gestartet (nicht ueber uwsm), deshalb aktiviert es sonst
    -- niemand - und ohne dieses Target bleiben alle xdg-desktop-portal-
    -- Backends tot. Electron-Anwendungen wie Discord und Chrome haengen dann
    -- beim Start. Das Target selbst weigert sich, direkt gestartet zu werden;
    -- hyprland-session.target zieht es per BindsTo herein.
    -- --no-block, weil systemctl sonst auf das Settling wartet und blockiert.
    hl.exec_cmd("systemctl --user start --no-block hyprland-session.target")
end)
LUA

# Tastaturlayout aus der Systemeinstellung uebernehmen. illogical-impulse setzt
# in hyprland/general.lua fest kb_layout = "us"; custom/general.lua wird danach
# geladen und ueberschreibt das.
#
# Layout und Variante muessen zusammenpassen - "us" kennt z.B. keine Variante
# "nodeadkeys", und Hyprland blendet dann eine rote Fehlermeldung ein. Deshalb
# werden beide Werte gemeinsam aus localectl uebernommen oder gar nicht.
KB_LAYOUT="$(localectl status 2>/dev/null | sed -n 's/^ *X11 Layout: *//p' | head -1)"
KB_VARIANT="$(localectl status 2>/dev/null | sed -n 's/^ *X11 Variant: *//p' | head -1)"
[ -z "$KB_LAYOUT" ] && KB_LAYOUT="us" && KB_VARIANT=""

write_once "$CONF/hypr/custom/general.lua" <<LUA
-- Tastaturlayout, uebernommen aus der Systemeinstellung (localectl).
-- illogical-impulse setzt in hyprland/general.lua fest kb_layout = "us";
-- diese Datei wird danach geladen und ueberschreibt das.
hl.config({
    input = {
        kb_layout = "${KB_LAYOUT}",
        kb_variant = "${KB_VARIANT}"
    }
})
LUA

# Monitor-Keybinds. Rein richtungsbasiert (l/r), damit der Block auf jeder
# Maschine passt, egal wie die Ausgaenge heissen.
append_once "$CONF/hypr/custom/keybinds.lua" "-- >>> bazz-hypr: monitor-keybinds" <<'LUA'
-- Fenster bzw. ganzen Workspace auf den Nachbarmonitor schieben.
--
-- Fuer Vollbild-Spiele die SHIFT-Variante nehmen: einen ganzen Workspace zu
-- verschieben laesst den Fullscreen-State intakt, waehrend ein einzeln
-- verschobenes Fenster zurueckspringt, sobald das Spiel den Fullscreen neu
-- greift.
for i = 1, 2 do
    local arrowkey = { "Left", "Right" }
    local mondir = { "l", "r" }
    hl.bind("SUPER + ALT + " .. arrowkey[i], hl.dsp.window.move({ monitor = mondir[i] }),
        { description = "Window: Move to monitor " .. arrowkey[i] })
    hl.bind("SUPER + SHIFT + ALT + " .. arrowkey[i], hl.dsp.workspace.move({ monitor = mondir[i] }),
        { description = "Workspace: Move to monitor " .. arrowkey[i] })
end
LUA

# Spiele-Monitor bestimmen: der groesste angeschlossene Schirm.
#
# Die DRM-Connector-Namen unter /sys/class/drm (DP-3, HDMI-A-1, ...) sind exakt
# die, die Hyprland selbst verwendet - sie taugen deshalb direkt als Wert fuer
# die Fensterregel. Erste Zeile von `modes` ist die hoechste Aufloesung des
# Anschlusses. So muss hier kein Ausgangsname fest verdrahtet werden.
detect_game_monitor() {
    local best="" best_px=0 dir conn mode w h px
    for dir in /sys/class/drm/card*-*; do
        [ -r "$dir/status" ] || continue
        [ "$(cat "$dir/status")" = "connected" ] || continue
        mode="$(head -1 "$dir/modes" 2>/dev/null)"
        w="${mode%%x*}"
        h="${mode##*x}"
        case "$w$h" in ''|*[!0-9]*) continue ;; esac
        px=$(( w * h ))
        if [ "$px" -gt "$best_px" ]; then
            best_px="$px"
            conn="$(basename "$dir")"
            best="${conn#card*-}"
        fi
    done
    printf '%s' "$best"
}

GAME_MONITOR="$(detect_game_monitor)"
if [ -z "$GAME_MONITOR" ]; then
    # Kein angeschlossener Ausgang gefunden (headless?). Marke wird nicht
    # gesetzt, der naechste Login versucht es erneut.
    log "kein Monitor erkannt - Spiele-Regel uebersprungen"
else
    {
        printf 'local gameMonitor = "%s"\n' "$GAME_MONITOR"
        cat <<'LUA'

hl.window_rule({ match = { content = "game" }, monitor = gameMonitor })

local gameClasses = {
    "^(cs2)$",
    "^(steam_app_[0-9]+)$",       -- Steam/Proton-Titel
    "^(gamescope)$",
    "^(.*\\.exe)$",               -- Wine/Proton ohne eigene Klasse
    "^(steam_proton)$",
}
for _, class in ipairs(gameClasses) do
    hl.window_rule({ match = { class = class }, monitor = gameMonitor })
end
LUA
    } | append_once "$CONF/hypr/custom/rules.lua" "-- >>> bazz-hypr: spiele-monitor"
fi

# --- 5. Python-venv ----------------------------------------------------------
# Zuletzt, weil es mit Abstand am laengsten dauert (~330 MB) und die Session
# ohne es startet. Die Quickshell-Skripte erwarten es unter genau diesem Pfad
# (hyprland/env.lua setzt ILLOGICAL_IMPULSE_VIRTUAL_ENV darauf).
# Kopie statt Symlink nach /usr, damit der Benutzer selbst Pakete nachlegen kann.
VENV="$STATE/quickshell/.venv"
if [ ! -x "$VENV/bin/python" ] && [ -d "$SHARE/venv" ]; then
    log "kopiere Python-venv nach $VENV (dauert einen Moment)"
    mkdir -p "$STATE/quickshell"
    rm -rf "$VENV" "$VENV.tmp"
    cp -a "$SHARE/venv" "$VENV.tmp"
    chmod -R u+w "$VENV.tmp"
    # Erst nach vollstaendiger Kopie umbenennen: ein abgebrochener Lauf
    # hinterlaesst dann kein halbes venv, das beim naechsten Mal als fertig gilt.
    if [ -x "$VENV.tmp/bin/python" ]; then
        mv "$VENV.tmp" "$VENV"
        log "venv bereit ($("$VENV/bin/python" -V 2>&1))"
    else
        log "FEHLER: venv-Kopie unvollstaendig, verwerfe sie"
        rm -rf "$VENV.tmp"
    fi
fi

# --- 6. Stempel --------------------------------------------------------------
printf '%s\n' "$VERSION" > "$STAMP"
log "fertig (Version $VERSION)"
