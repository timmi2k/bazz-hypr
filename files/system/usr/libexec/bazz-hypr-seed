#!/usr/bin/env bash
# Populates the calling user's HOME with illogical-impulse + end4-pC.
#
# Why this is needed at all: /etc/skel only applies to NEWLY created users. This
# image arrives via `rpm-ostree rebase` on a machine where the account has long
# existed - skel would never be evaluated there.
#
# Idempotent: runs on every login, but only does something when the image
# version changed or files are missing.
set -euo pipefail

SHARE="/usr/share/bazz-hypr"
DOTS="$SHARE/dots-hyprland/dots"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}"
STAMP="$STATE/bazz-hypr/seeded"
LOCK="$STATE/bazz-hypr/seed.lock"

log() { printf '[bazz-hypr-seed] %s\n' "$*"; }

test -d "$DOTS" || { log "ERROR: $DOTS missing - broken image?"; exit 1; }

mkdir -p "$CONF" "$DATA" "$STATE/bazz-hypr"

# --- 0. Lock -----------------------------------------------------------------
# This script has two triggers: the session wrapper and the user unit
# bazz-hypr-firstrun.service. Both start practically simultaneously on login.
#
# Without a lock the second run deleted the first one's staging directory
# mid-copy via `rm -rf "$VENV.tmp"`; the first then aborted through `set -e`
# before it could write the configuration, and Hyprland started without
# hyprland.lua. That is exactly how the first real login went wrong.
exec 9>"$LOCK"
if ! flock -w 300 9; then
    log "ERROR: could not acquire lock $LOCK"
    exit 1
fi

VERSION="$(cat "$SHARE/dots-version" 2>/dev/null || echo unknown)"
STAMPED="$(cat "$STAMP" 2>/dev/null || true)"

# --- 1. Upstream's own configuration -----------------------------------------
# DELIBERATELY BEFORE the venv: Hyprland starts right after this script and
# needs hyprland.lua immediately. Copying the venv takes considerably longer and
# is not critical for starting the session.
#
# These paths belong to illogical-impulse and are overwritten on every image
# update - the upstream installer does the same.
if [ "$VERSION" != "$STAMPED" ]; then
    log "syncing upstream configuration (version $VERSION)"
    mkdir -p "$CONF/quickshell" "$CONF/hypr"

    # shellOverrides/ belongs to the shell's settings GUI, not to upstream:
    # rounding, blur, gaps, layout, keyboard layout and touchpad values land
    # there as soon as the user touches that dialog once. The rsync below runs
    # with --delete and would discard exactly that.
    #
    # So: save it first, put it back afterwards. The order matters - the rsync
    # runs in between so that genuinely new upstream files still arrive, and the
    # user's own files are laid back on top of them.
    OVERRIDES="$CONF/hypr/hyprland/shellOverrides"
    OVERRIDES_BAK=""
    if [ -d "$OVERRIDES" ]; then
        OVERRIDES_BAK="$(mktemp -d "$STATE/bazz-hypr/shellOverrides.XXXXXX")"
        cp -a "$OVERRIDES/." "$OVERRIDES_BAK/"
    fi

    rsync -a --delete "$DOTS/.config/quickshell/ii/" "$CONF/quickshell/ii/"
    rsync -a --delete "$DOTS/.config/hypr/hyprland/" "$CONF/hypr/hyprland/"
    rsync -a           "$DOTS/.config/matugen/"       "$CONF/matugen/"

    if [ -n "$OVERRIDES_BAK" ]; then
        mkdir -p "$OVERRIDES"
        cp -a "$OVERRIDES_BAK/." "$OVERRIDES/"
        rm -rf "$OVERRIDES_BAK"
        log "kept shellOverrides/ (settings made in the shell GUI)"
    fi

    mkdir -p "$DATA/icons"
    cp -f "$DOTS/.local/share/icons/illogical-impulse.svg" "$DATA/icons/" 2>/dev/null || true
fi

# hyprland.lua also belongs to upstream and is always refreshed.
#
# Important: if Hyprland starts and the file is missing, it writes itself a
# default configuration to exactly this location ("No config file found;
# attempting to generate"). If we only copied when the file was absent, that
# generated default would stay forever - the desktop would come up on every
# login without keybinds, without the shell autostart and without settings.
if ! cmp -s "$DOTS/.config/hypr/hyprland.lua" "$CONF/hypr/hyprland.lua"; then
    if [ -f "$CONF/hypr/hyprland.lua" ]; then
        cp -f "$CONF/hypr/hyprland.lua" "$CONF/hypr/hyprland.lua.bak"
        log "hyprland.lua differs - previous version saved as hyprland.lua.bak"
    fi
    install -m 0644 "$DOTS/.config/hypr/hyprland.lua" "$CONF/hypr/hyprland.lua"
    log "hyprland.lua installed from the image"
fi

# --- 2. User-owned configuration ---------------------------------------------
# Only created when absent. After a rebase the user has a configured KDE - do
# not steamroll its kitty/fish/kdeglobals.
seed_if_missing() {
    local src="$1" dst="$2"
    [ -e "$dst" ] && return 0
    mkdir -p "$(dirname "$dst")"
    cp -a "$src" "$dst"
    chmod -R u+w "$dst"
    log "created: ${dst#"$HOME"/}"
}

for entry in "$DOTS"/.config/*; do
    name="$(basename "$entry")"
    case "$name" in
        quickshell|hypr|matugen) continue ;;   # handled above
    esac
    seed_if_missing "$entry" "$CONF/$name"
done

for f in hyprlock.conf hypridle.conf; do
    seed_if_missing "$DOTS/.config/hypr/$f" "$CONF/hypr/$f"
done
seed_if_missing "$DOTS/.config/hypr/hyprlock" "$CONF/hypr/hyprlock"
seed_if_missing "$DOTS/.config/hypr/custom"   "$CONF/hypr/custom"
seed_if_missing "$DOTS/.local/share/konsole"  "$DATA/konsole"

# --- 3. end4-pC --------------------------------------------------------------
# Pure Quickshell config directory (GPL-3.0), requires illogical-impulse.
# Copied as a real git checkout so that `git pull` works inside it.
if [ ! -d "$CONF/quickshell/end4-pC" ] && [ -d "$SHARE/end4-pC" ]; then
    log "installing end4-pC to $CONF/quickshell/end4-pC"
    mkdir -p "$CONF/quickshell"
    cp -a "$SHARE/end4-pC" "$CONF/quickshell/end4-pC"
    chmod -R u+w "$CONF/quickshell/end4-pC"
fi

# --- 4. Our own adjustments in hypr/custom/ ----------------------------------
# custom/ is never touched by illogical-impulse updates - the right place for
# Nvidia variables, keyboard layout and the shell selection.
#
# CAREFUL with the emptiness check: upstream's templates are not 0 bytes, they
# contain a single newline. A test for `[ -s ]` wrongly considers them filled
# and skips writing - that is exactly what the first attempt failed on. Hence
# the check for "whitespace only".
is_effectively_empty() {
    [ ! -e "$1" ] && return 0
    [ -z "$(tr -d '[:space:]' < "$1" 2>/dev/null)" ]
}

write_once() {
    local path="$1"
    if ! is_effectively_empty "$path"; then
        cat > /dev/null   # drain the heredoc
        return 0
    fi
    mkdir -p "$(dirname "$path")"
    cat > "$path"
    log "written: ${path#"$HOME"/}"
}

# Appends a marked block instead of writing the whole file.
#
# Why in addition to write_once: write_once only touches a file while it is
# empty. But upstream ships custom/keybinds.lua with one line already in it
# ("Edit user keybinds"), so write_once would always skip it - the block would
# never have landed on a fresh installation.
#
# The marker stays in the file as a comment and is the only detection: a second
# run finds it and appends nothing. To get rid of the block, delete it together
# with its marker - it comes back on the next login; to adjust it, leave the
# marker in place and edit freely below it.
append_once() {
    local path="$1" marker="$2"
    # -e is mandatory, not cosmetic: the marker starts with "--". Without -e
    # grep takes it for an option list, aborts and thereby reports "not found" -
    # the block would have been appended again on EVERY login.
    if [ -e "$path" ] && grep -qFe "$marker" "$path" 2>/dev/null; then
        cat > /dev/null   # drain the heredoc
        return 0
    fi
    mkdir -p "$(dirname "$path")"
    printf '\n%s\n' "$marker" >> "$path"
    cat >> "$path"
    log "extended: ${path#"$HOME"/}"
}

write_once "$CONF/hypr/custom/env.lua" <<'LUA'
-- Nvidia. As of wiki.hypr.land/Nvidia/ (retrieved 2026-09-08).
-- Only these two variables are still recommended. GBM_BACKEND=nvidia-drm is
-- NOT listed there any more - it caused more problems (among others in
-- Firefox) than it solved, so it is deliberately left out here.
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")

-- Hardware video decoding through NVDEC instead of the VDPAU detour.
hl.env("NVD_BACKEND", "direct")

-- With multiple GPUs, pin the desired card here, e.g.:
-- hl.env("AQ_DRM_DEVICES", "/dev/dri/card1:/dev/dri/card0")
LUA

write_once "$CONF/hypr/custom/variables.lua" <<'LUA'
-- Which directory under ~/.config/quickshell/ provides the shell.
-- "ii"       = illogical-impulse as shipped
-- "end4-pC"  = pctrade's fork (bundled with this image)
hl.env("qsConfig", "end4-pC")
LUA

write_once "$CONF/hypr/custom/execs.lua" <<'LUA'
-- On Fedora the polkit agent does not start on its own. Without it no dialog
-- appears at all when something asks for privileges.
--
-- The upstream installer appends the line for this to hypr/hyprland/execs.conf
-- - a file that is no longer read since the switch to Lua.
-- gnome-keyring-daemon is deliberately NOT started here, hyprland/execs.lua
-- already does that itself.
hl.on("hyprland.start", function()
    hl.exec_cmd("/usr/libexec/kf6/polkit-kde-authentication-agent-1")

    -- Bring up graphical-session.target. Hyprland is started directly by the
    -- login manager (not through uwsm), so otherwise nobody activates it - and
    -- without this target all xdg-desktop-portal backends stay dead. Electron
    -- applications such as Discord and Chrome then hang on startup. The target
    -- itself refuses to be started directly; hyprland-session.target pulls it
    -- in via BindsTo.
    -- --no-block, because systemctl would otherwise wait for settling and block.
    hl.exec_cmd("systemctl --user start --no-block hyprland-session.target")
end)
LUA

# Take the keyboard layout from the system setting. illogical-impulse hardcodes
# kb_layout = "us" in hyprland/general.lua; custom/general.lua is loaded
# afterwards and overrides it.
#
# Layout and variant have to match - "us" for instance does not know the variant
# "nodeadkeys", and Hyprland then shows a red error message. That is why both
# values are taken from localectl together, or not at all.
KB_LAYOUT="$(localectl status 2>/dev/null | sed -n 's/^ *X11 Layout: *//p' | head -1)"
KB_VARIANT="$(localectl status 2>/dev/null | sed -n 's/^ *X11 Variant: *//p' | head -1)"
[ -z "$KB_LAYOUT" ] && KB_LAYOUT="us" && KB_VARIANT=""

write_once "$CONF/hypr/custom/general.lua" <<LUA
-- Keyboard layout, taken from the system setting (localectl).
-- illogical-impulse hardcodes kb_layout = "us" in hyprland/general.lua;
-- this file is loaded afterwards and overrides it.
hl.config({
    input = {
        kb_layout = "${KB_LAYOUT}",
        kb_variant = "${KB_VARIANT}"
    }
})
LUA

# Monitor keybinds. Purely direction based (l/r) so that the block fits on any
# machine, no matter what the outputs are called.
append_once "$CONF/hypr/custom/keybinds.lua" "-- >>> bazz-hypr: monitor-keybinds" <<'LUA'
-- Move a window, or a whole workspace, to the neighbouring monitor.
--
-- For fullscreen games take the SHIFT variant: moving a whole workspace leaves
-- the fullscreen state intact, whereas a window moved on its own jumps back as
-- soon as the game re-grabs fullscreen.
for i = 1, 2 do
    local arrowkey = { "Left", "Right" }
    local mondir = { "l", "r" }
    hl.bind("SUPER + ALT + " .. arrowkey[i], hl.dsp.window.move({ monitor = mondir[i] }),
        { description = "Window: Move to monitor " .. arrowkey[i] })
    hl.bind("SUPER + SHIFT + ALT + " .. arrowkey[i], hl.dsp.workspace.move({ monitor = mondir[i] }),
        { description = "Workspace: Move to monitor " .. arrowkey[i] })
end
LUA

# Determine the gaming monitor: the largest connected screen.
#
# The DRM connector names under /sys/class/drm (DP-3, HDMI-A-1, ...) are exactly
# the ones Hyprland itself uses - so they can be dropped straight into the
# window rule. The first line of `modes` is the highest resolution of that
# connector. This way no output name has to be hardcoded here.
detect_game_monitor() {
    local best="" best_px=0 dir conn mode w h px
    for dir in /sys/class/drm/card*-*; do
        [ -r "$dir/status" ] || continue
        [ "$(cat "$dir/status")" = "connected" ] || continue
        mode="$(head -1 "$dir/modes" 2>/dev/null)"
        w="${mode%%x*}"
        h="${mode##*x}"
        case "$w$h" in ''|*[!0-9]*) continue ;; esac
        px=$(( w * h ))
        if [ "$px" -gt "$best_px" ]; then
            best_px="$px"
            conn="$(basename "$dir")"
            best="${conn#card*-}"
        fi
    done
    printf '%s' "$best"
}

GAME_MONITOR="$(detect_game_monitor)"
if [ -z "$GAME_MONITOR" ]; then
    # No connected output found (headless?). The marker is not written, so the
    # next login tries again.
    log "no monitor detected - game rule skipped"
else
    {
        printf 'local gameMonitor = "%s"\n' "$GAME_MONITOR"
        cat <<'LUA'

hl.window_rule({ match = { content = "game" }, monitor = gameMonitor })

local gameClasses = {
    "^(cs2)$",
    "^(steam_app_[0-9]+)$",       -- Steam/Proton titles
    "^(gamescope)$",
    "^(.*\\.exe)$",               -- Wine/Proton without a class of its own
    "^(steam_proton)$",
}
for _, class in ipairs(gameClasses) do
    hl.window_rule({ match = { class = class }, monitor = gameMonitor })
end
LUA
    } | append_once "$CONF/hypr/custom/rules.lua" "-- >>> bazz-hypr: game-monitor"
fi

# --- 5. Python venv ----------------------------------------------------------
# Last, because it takes by far the longest (~330 MB) and the session starts
# without it. The Quickshell scripts expect it at exactly this path
# (hyprland/env.lua points ILLOGICAL_IMPULSE_VIRTUAL_ENV at it).
# A copy instead of a symlink into /usr, so the user can add packages.
VENV="$STATE/quickshell/.venv"
if [ ! -x "$VENV/bin/python" ] && [ -d "$SHARE/venv" ]; then
    log "copying Python venv to $VENV (takes a moment)"
    mkdir -p "$STATE/quickshell"
    rm -rf "$VENV" "$VENV.tmp"
    cp -a "$SHARE/venv" "$VENV.tmp"
    chmod -R u+w "$VENV.tmp"
    # Only rename after a complete copy: an aborted run then leaves no half
    # venv behind that would count as finished next time.
    if [ -x "$VENV.tmp/bin/python" ]; then
        mv "$VENV.tmp" "$VENV"
        log "venv ready ($("$VENV/bin/python" -V 2>&1))"
    else
        log "ERROR: venv copy incomplete, discarding it"
        rm -rf "$VENV.tmp"
    fi
fi

# --- 6. Stamp ----------------------------------------------------------------
printf '%s\n' "$VERSION" > "$STAMP"
log "done (version $VERSION)"
