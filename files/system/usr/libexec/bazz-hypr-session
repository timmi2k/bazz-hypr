#!/usr/bin/env bash
# Session wrapper: make sure the configuration exists, then start Hyprland.
#
# The user unit bazz-hypr-firstrun.service runs in parallel with the session
# start. On the very first login after a rebase Hyprland can overtake it and
# come up without a configuration. This wrapper does the seeding synchronously
# beforehand - it is idempotent and costs only milliseconds afterwards.
set -uo pipefail

if [ -x /usr/libexec/bazz-hypr-seed ]; then
    /usr/libexec/bazz-hypr-seed || echo "bazz-hypr-seed failed" >&2
fi

# Safety net: without hyprland.lua, Hyprland writes itself a default
# configuration to this location on startup ("No config file found; attempting
# to generate") - the desktop then comes up without keybinds, without the shell
# and without settings, and the generated file stays behind afterwards.
# That is exactly what happened on the first real login, because the seeding
# had aborted beforehand. Hence this last check before Hyprland starts.
HYPRLAND_LUA="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
UPSTREAM_LUA=/usr/share/bazz-hypr/dots-hyprland/dots/.config/hypr/hyprland.lua
if [ ! -s "$HYPRLAND_LUA" ] && [ -f "$UPSTREAM_LUA" ]; then
    echo "bazz-hypr-session: hyprland.lua missing, installing it from the image" >&2
    mkdir -p "$(dirname "$HYPRLAND_LUA")"
    install -m 0644 "$UPSTREAM_LUA" "$HYPRLAND_LUA"
fi

# Bring up graphical-session.target as soon as the compositor has created its
# socket.
#
# This is also in custom/execs.lua - but that file is written once and never
# touched again, so that local changes are preserved. Existing installations
# would therefore never receive the fix there. Here it applies regardless.
#
# Without the target all xdg-desktop-portal backends stay dead and Electron
# applications (Discord, Chrome) hang on startup.
(
    for _ in $(seq 1 40); do
        if [ -n "$(ls -A "/run/user/$(id -u)/hypr" 2>/dev/null)" ]; then
            break
        fi
        sleep 0.5
    done
    systemctl --user start --no-block hyprland-session.target 2>/dev/null || true
) &

# start-hyprland instead of Hyprland directly.
#
# Otherwise Hyprland warns visibly on startup: "Hyprland is being launched
# without start-hyprland. This is highly advised against." start-hyprland is a
# watchdog process that supervises the compositor and cleans up properly after
# a crash; the official /usr/share/wayland-sessions/hyprland.desktop starts it
# as well (Exec=/usr/bin/start-hyprland).
#
# Arguments after "--" are passed through by start-hyprland to Hyprland.
# Fallback to the bare binary in case a future packaging does not ship the
# watchdog - a wrong path would otherwise mean the session does not start at
# all and the user lands back at the login manager without a word.
if command -v start-hyprland >/dev/null 2>&1; then
    if [ "$#" -gt 0 ]; then
        exec "$(command -v start-hyprland)" -- "$@"
    fi
    exec "$(command -v start-hyprland)"
fi

for bin in Hyprland hyprland; do
    if command -v "$bin" >/dev/null 2>&1; then
        echo "bazz-hypr-session: start-hyprland missing, starting $bin directly" >&2
        exec "$(command -v "$bin")" "$@"
    fi
done

echo "bazz-hypr-session: no Hyprland binary found" >&2
exit 1
